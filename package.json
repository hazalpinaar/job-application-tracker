{
  "name": "job-application-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/prepare-db.mjs && prisma db push",
    "postinstall": "prisma generate",
    "dev:network": "next dev --hostname 0.0.0.0",
    "test:auth": "node scripts/auth-smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
