DATABASE_URL="file:./dev.db"

# Live HTTPS deployment: set the exact public origin (no path).
# APP_ORIGIN="https://rota.example.com"

# Set true for a public service after SMTP is configured.
REQUIRE_EMAIL_VERIFICATION="false"

# Real mail: SMTP with TLS. Keep all credentials in .env, never in Git.
# MAIL_TRANSPORT="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASSWORD="your-smtp-password"
# MAIL_FROM="Rota <noreply@example.com>"

# Local mail preview only: enable these two lines to save messages to work/mail/.
# No real email is sent. The folder is private and ignored by Git.
# APP_ORIGIN="http://127.0.0.1:3000"
# MAIL_TRANSPORT="file"
